{
  "name": "hostnextra",
  "version": "1.0.8",
  "description": "Official command line interface for the HostnExtra ecosystem.",
  "license": "MIT",
  "author": "HostnExtra",
  "homepage": "https://github.com/hostnextra/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/hostnextra/cli.git"
